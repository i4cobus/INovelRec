.venv/
__pycache__/
.pytest_cache/
*.pyc
data/
reports/
# Evaluation artifacts. The aggregate JSONs and the per-arm judged rows are the
# evidence behind every number in the README, so they are tracked. Everything
# else under here is either raw intermediate output (the judged CSV is a strict
# superset of it) or carries raw corpus text and stays out.
eval/results/*
!eval/results/*.json
!eval/results/README.md
!eval/results/eval_results_judged.csv
!eval/results/eval_results_judged_clean.csv
!eval/results/eval_results_judged_flash.csv
!eval/results/*/
eval/results/*/*
!eval/results/*/eval_results_judged.csv
!eval/results/*/eval_run_config.json
eval/manual_judgements.csv
# Annotation sheets inline raw novel excerpts from the private corpus.
eval/manual_judgements_sheet.csv
eval/*_sheet.csv
# Inlines ~4,200 chars of raw novel text per entry, same as the sheets above.
eval/disagreements_to_review.md
docs/prompt*.md
docs/pre_interview.md
streamlit.out.log

CLAUDE.md
docs/

# verl run artifacts: hydra's per-run config dumps and tensorboard event files.
# Regenerated by every training run and specific to one machine's paths.
outputs/
tensorboard_log/
